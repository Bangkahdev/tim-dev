# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.
#
# Format model: provider/nama-model
#   Lokal (Ollama) : ollama/qwen2.5-coder:1.5b
#   Cloud          : openai/..., anthropic/..., gemini/..., openrouter/..., groq/...
# Nama model cloud mengikuti dokumentasi masing-masing provider (litellm).

# --- Model per kelompok ---
MODEL_MANAGER=ollama/qwen2.5-coder:1.5b
MODEL_CODER=ollama/qwen2.5-coder:1.5b
MODEL_SPECIALIST=ollama/llama3.2:3b

# --- Override per karyawan (opsional, hapus tanda # untuk memakai) ---
# lead, coo, architect, backend, api, frontend, qa
# MODEL_LEAD=anthropic/nama-model
# MODEL_BACKEND=openai/nama-model
# MODEL_QA=ollama/llama3.2:3b

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
# Model embedding untuk semantic RAG (jalankan: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Batas kerja ---
MAX_REPAIR_ROUNDS=3
COMMAND_TIMEOUT=120

# --- Sandbox eksekusi (NFR-SEC-09/10) ---
# Kosong = eksekusi tanpa wrapper (status isolasi dilaporkan jujur: belum terbukti).
# Untuk Milestone 1 --worker real, isi keduanya dengan wrapper nyata.
# Contoh Docker (image harus punya Python + pytest):
#   BANGKAH_SANDBOX_REQUIRED=1
#   BANGKAH_SANDBOX_CMD=docker run --rm --network none -v {project_dir}:/work -w /work <image>
# Contoh bubblewrap di Linux (tanpa Docker):
#   BANGKAH_SANDBOX_REQUIRED=1
#   BANGKAH_SANDBOX_CMD=/usr/bin/bwrap --unshare-net --die-with-parent --ro-bind /usr /usr --ro-bind /home/<user>/.local/share/uv/python /home/<user>/.local/share/uv/python --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --bind {project_dir} /work --chdir /work --setenv PATH /usr/bin:/bin --setenv HOME /tmp
# Token {project_dir} wajib ada. Canary preflight akan menolak wrapper yang
# tidak memblokir baca file di luar project atau koneksi keluar.
BANGKAH_SANDBOX_REQUIRED=
BANGKAH_SANDBOX_CMD=

# --- API key cloud (isi hanya yang dipakai) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Server API / keamanan ---
# Server hanya menerima bind loopback. Untuk akses remote, biarkan host ini
# localhost dan gunakan reverse proxy HTTPS yang meneruskan Authorization.
BANGKAH_HOST=127.0.0.1
BANGKAH_PORT=8765
# Token bersama lama. Token ini BUKAN identitas login. Biarkan kosong.
BANGKAH_API_TOKEN=
# Migrasi eksplisit: hanya set jika klien lama wajib memakai BANGKAH_API_TOKEN.
# Nilai: owner | secretary | manager | employee | admin. Kosong = token ditolak.
BANGKAH_LEGACY_TOKEN_ROLE=
# Umur sesi login web/API dalam jam (default 8).
BANGKAH_SESSION_HOURS=8

# --- Workstation / Bangkah OS ---
# Kosong = backend membuat sandi Owner pada data/owner_credentials.local.
BANGKAH_OWNER_PASSWORD=
# Umur sesi desktop per workstation dalam jam.
BANGKAH_DESKTOP_SESSION_HOURS=8
BANGKAH_EMPLOYEE_ACCOUNTS=1
BANGKAH_EMPLOYEE_PASSWORD=
BANGKAH_EMPLOYEE_ACTIVITY=1
BANGKAH_EMPLOYEE_DUTY_HOURS=9-17
BANGKAH_EMPLOYEE_TICK_SECONDS=20
# Allowlist binary eksternal terminal (argv + path resolve, tanpa shell).
# Kosong = hanya builtin yang diizinkan. Contoh:
# BANGKAH_TERMINAL_ALLOWED_BINARIES=C:\Windows\System32\where.exe
BANGKAH_TERMINAL_ALLOWED_BINARIES=
# Domain perusahaan untuk tampilan system info. Status DNS/email tetap
# dilaporkan jujur (false) sampai benar-benar dikelola.
BANGKAH_DOMAIN=bangkah.my.id

# --- Email keluar (opsional; hanya aktif lewat Approval + Outbox) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Deployment website (opsional; HTTPS webhook + bearer token) ---
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_TOKEN=

# --- Retry & reconciliation outbox eksternal ---
# Percobaan maksimum sebelum item berhenti retry dan menunggu rekonsiliasi manual.
OUTBOX_MAX_ATTEMPTS=5
# Backoff eksponensial: base * 2^(attempts-1), dibatasi nilai maksimum.
OUTBOX_BACKOFF_SECONDS=30
OUTBOX_BACKOFF_MAX_SECONDS=3600
