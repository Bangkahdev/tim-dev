# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.
#
# Format model: provider/nama-model
#   Lokal (Ollama) : ollama/qwen2.5-coder:1.5b
#   Cloud          : openai/..., anthropic/..., gemini/..., openrouter/..., groq/...
# Nama model cloud mengikuti dokumentasi masing-masing provider (litellm).

# --- Model per kelompok ---
MODEL_MANAGER=ollama/qwen2.5-coder:1.5b
MODEL_CODER=ollama/qwen2.5-coder:1.5b
MODEL_SPECIALIST=ollama/llama3.2:3b

# --- Override per karyawan (opsional, hapus tanda # untuk memakai) ---
# lead, coo, architect, backend, api, frontend, qa
# MODEL_LEAD=anthropic/nama-model
# MODEL_BACKEND=openai/nama-model
# MODEL_QA=ollama/llama3.2:3b

# --- Ollama ---
OLLAMA_URL=http://localhost:11434

# --- Batas kerja ---
MAX_REPAIR_ROUNDS=3
MAX_MEETING_ROUNDS=3
MAX_MEETING_TOKENS=4000
COMMAND_TIMEOUT=120

# --- API key cloud (isi hanya yang dipakai) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Server dan keamanan ---
# Bind hanya ke loopback secara default (NFR-SEC-03).
BANGKAH_HOST=127.0.0.1
BANGKAH_PORT=8765
# Bila diisi, POST /api/session wajib menyertakan token ini.
# Kosongkan hanya untuk pemakaian lokal di mesin Owner.
API_AUTH_TOKEN=
OWNER_SESSION_HOURS=12
APPROVAL_TTL_HOURS=72
MAX_REQUEST_BYTES=1048576
PAPER_TRAY_LIMIT=15

# --- Lokasi data ---
BANGKAH_DATA_DIR=data
BANGKAH_DB_PATH=data/bangkah.db
BANGKAH_PRINT_DIR=data/prints
BANGKAH_REPORT_DIR=reports
BANGKAH_WORKSPACE_DIR=workspace
BANGKAH_DOCS_DIR=docs

# --- Email perusahaan (EML) ---
# Kredensial hanya dibaca backend; tidak pernah masuk prompt/subprocess.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=1
EMAIL_SENT_FOLDER=Sent
EMAIL_SEND_LIMIT_PER_HOUR=20
EMAIL_SEND_LIMIT_PER_DAY=50
# Interval tarik inbox otomatis (menit); 0 mematikan.
EMAIL_SYNC_MINUTES=5

# --- Website perusahaan (WEB) ---
# Publikasi menyusun ulang folder deploy dari folder sumber dan membuat backup
# sebelum setiap rilis.
WEBSITE_URL=
WEBSITE_DEPLOY_TOKEN=
BANGKAH_WEBSITE_SOURCE_DIR=website
BANGKAH_WEBSITE_DEPLOY_DIR=workspace/website-live
BANGKAH_WEBSITE_BACKUP_DIR=data/website-backups

# --- Batas kerja backend ---
MAX_CONCURRENT_PROJECTS=2
DAILY_TOKEN_BUDGET=0
EVENT_RETENTION_HOURS=72
EVENT_RETENTION_COUNT=5000
# Lewati pemeriksaan Ollama saat pengembangan/tes.
BANGKAH_SKIP_MODEL_CHECK=0
