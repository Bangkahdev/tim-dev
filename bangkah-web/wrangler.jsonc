{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangkah-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "bangkah.web.id", "custom_domain": true },
    { "pattern": "www.bangkah.web.id", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bangkah-contacts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ]
}
